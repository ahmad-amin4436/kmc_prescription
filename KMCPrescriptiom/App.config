<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/>
	</startup>

	<connectionStrings>
		<add name="KMC" connectionString="Server=.\SQLEXPRESS;Database=KMC;User Id=sa;Password=abcd@1234;" providerName="System.Data.SqlClient"/>
	</connectionStrings>

	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<!-- Force assembly resolution to look in application directory first -->
			<probing privatePath="."/>

			<!-- Crystal Reports assemblies -->
			<dependentAssembly>
				<assemblyIdentity name="CrystalDecisions.Shared" publicKeyToken="692fbea5521e1304" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-13.0.2500.0" newVersion="13.0.2500.0"/>
			</dependentAssembly>

			<dependentAssembly>
				<assemblyIdentity name="CrystalDecisions.CrystalReports.Engine" publicKeyToken="692fbea5521e1304" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-13.0.2500.0" newVersion="13.0.2500.0"/>
			</dependentAssembly>

			<dependentAssembly>
				<assemblyIdentity name="CrystalDecisions.ReportAppServer.CommLayer" publicKeyToken="692fbea5521e1304" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-13.0.2500.0" newVersion="13.0.2500.0"/>
			</dependentAssembly>

			<!-- log4net required by Crystal Reports -->
			<!-- Crystal Reports expects version 1.2.10.0 with PublicKeyToken=692fbea5521e1304 -->
			<!-- IMPORTANT: You must include log4net.dll version 1.2.10.0 in your deployment -->
			<!-- This DLL can be found in Crystal Reports installation directory or downloaded separately -->
			<!-- Use codeBase to force loading from application directory to avoid GAC conflicts -->
	
		</assemblyBinding>
	</runtime>
</configuration>
